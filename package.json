{
  "name": "voiceassistant",
  "version": "0.2.0",
  "private": true,
  "description": "Fast local desktop helper for technical questions.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev -w @voiceassistant/backend",
    "dev:desktop": "npm run dev -w @voiceassistant/desktop",
    "dev:all": "node scripts/dev-supervisor.mjs",
    "stop:dev": "powershell -ExecutionPolicy Bypass -File scripts/stop-dev.ps1",
    "check:ports": "powershell -ExecutionPolicy Bypass -File scripts/check-ports.ps1",
    "verify": "npm run test:knowledge && npm run test:launcher && npm run test:backend && npm run build",
    "verify:win": "powershell -ExecutionPolicy Bypass -File scripts/verify.ps1",
    "release:check": "powershell -ExecutionPolicy Bypass -File scripts/release-check.ps1",
    "release:checksum": "powershell -ExecutionPolicy Bypass -File scripts/release-checksum.ps1",
    "build": "npm run build -w @voiceassistant/shared && npm run build -w @voiceassistant/backend && npm run build -w @voiceassistant/desktop",
    "build:packaged-backend": "node scripts/build-packaged-backend.mjs",
    "build:backend": "npm run build -w @voiceassistant/backend",
    "build:desktop": "npm run build -w @voiceassistant/desktop",
    "test:backend": "npm run test -w @voiceassistant/backend",
    "test:knowledge": "npm run build -w @voiceassistant/shared && tsx scripts/test-local-knowledge.ts",
    "test:launcher": "node --test scripts/dev-process-policy.test.mjs && node scripts/dev-supervisor.mjs --smoke",
    "test:packaged": "node scripts/test-packaged.mjs",
    "clean:desktop-release": "powershell -ExecutionPolicy Bypass -File scripts/clean-desktop-release.ps1",
    "package:desktop": "npm run clean:desktop-release && npm run build && npm run build:packaged-backend && npm run package -w @voiceassistant/desktop",
    "dist:desktop": "npm run clean:desktop-release && npm run build && npm run build:packaged-backend && npm run dist -w @voiceassistant/desktop"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12"
  }
}
